# --- RPC (get a free-tier key from Helius or QuickNode) ---
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=TU_API_KEY
RPC_WEBSOCKET=wss://mainnet.helius-rpc.com/?api-key=TU_API_KEY

# --- Wallets ---
# Public address where platform fees land. Use a wallet you control, NOT the server wallet below.
PLATFORM_FEE_WALLET=TuDireccionPublicaDeCobro

# Private key (base58, e.g. from `solana-keygen` or Phantom's export) of a
# HOT WALLET that only pays network/compute fees. Fund it with ~0.05 SOL.
# NEVER put real treasury funds in this wallet, and never commit this file.
SERVER_WALLET_PRIVATE_KEY=

# --- IPFS (Pinata — free tier is enough to start) ---
PINATA_JWT=
PINATA_GATEWAY=gateway.pinata.cloud

# --- Database ---
DATABASE_URL=postgresql://launchpad:launchpad@localhost:5432/launchpad

# --- Redis (only needed once you wire up the BullMQ queue) ---
REDIS_URL=redis://localhost:6379

# --- Fee config (montos fijos en SOL) ---
BASE_FEE_SOL=0.5
ASSET_FEE_SOL=0.1

PORT=4000
