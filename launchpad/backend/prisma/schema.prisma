generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Token {
  id            String   @id @default(cuid())
  mintAddress   String   @unique
  name          String
  symbol        String
  description   String?
  imageUrl      String
  metadataCid   String?
  totalSupply   BigInt
  liquiditySol  Float
  creatorWallet String
  createdAt     DateTime @default(now())
  copiedFrom    String?
  txHash        String
  poolAddress   String?
  poolQuoteMint String   @default("So11111111111111111111111111111111111111112")
  pendingPoolAddress String?
  pendingPoolQuoteMint String?
  pendingPoolMessageHash String?
  pendingPoolLastValidBlockHeight BigInt?
  launchPlatform String   @default("RAYDIUM")
  bondingCurveAddress String?
  holderReward   Boolean  @default(false)
  status        String   @default("created")
  
  // Assets de seguridad
  lockType      String?  // "temporal" o "quemaTotal"
  lockDuration  Int?     // Días de bloqueo (ej. 180)
  lockTxHash    String?  // Hash de la transacción de bloqueo
  auditStatus   String?  // "verified" o "pending"

  @@index([creatorWallet, createdAt])
}

model FeePayment {
  id             String   @id @default(cuid())
  userWallet     String
  tokenMint      String   @unique
  amountSol      Float
  amountLamports BigInt?
  txHash          String
  createdAt      DateTime @default(now())

  @@index([userWallet, createdAt])
}

// ============================================================
// NUEVO: Modelo para registrar retiros de liquidez
// ============================================================

model Withdrawal {
  id                     String   @id @default(cuid())
  userWallet             String
  poolAddress            String
  lpTokenAmount          Float
  userAmount             Float
  platformFee            Float
  status                 String   @default("pending") // pending, completed, failed, expired, expired_unverified
  txHash                 String?
  verifiedTxHash         String?  @unique
  transactionMessageHash String?
  lastValidBlockHeight   BigInt?
  lpTokenAmountRaw       Decimal? @db.Decimal(20, 0)
  userAmountLamports     BigInt?
  platformFeeLamports    BigInt?
  quoteAmountRaw         BigInt?
  platformFeeRaw         BigInt?
  quoteMint              String   @default("So11111111111111111111111111111111111111112")
  quoteDecimals          Int      @default(9)
  createdAt              DateTime @default(now())

  @@index([status, lastValidBlockHeight])
  @@index([userWallet, createdAt])
}

model Swap {
  id             String   @id @default(cuid())
  signature      String   @unique
  userWallet     String
  mintAddress    String
  poolAddress    String
  venue          String   @default("RAYDIUM")
  side           String
  tokenAmountRaw Decimal  @db.Decimal(30, 0)
  solAmountLamports BigInt?
  quoteAmountRaw Decimal? @db.Decimal(30, 0)
  quoteMint      String   @default("So11111111111111111111111111111111111111112")
  quoteDecimals  Int      @default(9)
  tokenDecimals  Int
  slot           BigInt
  blockTime      DateTime?
  networkFeeLamports BigInt?
  createdAt      DateTime @default(now())

  @@index([userWallet, createdAt])
  @@index([userWallet, slot])
  @@index([mintAddress, createdAt])
  @@index([poolAddress, createdAt])
}
