# URL del backend (el servidor Express que corre en /backend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# RPC de Solana que usa el navegador del usuario para leer el estado de la wallet.
# Usa el mismo RPC que el backend (Devnet mientras pruebas, mainnet-beta cuando ya
# vayas en serio). No pongas aquí una API key paga si el RPC no la necesita en el
# cliente — cualquier cosa en NEXT_PUBLIC_* queda visible en el navegador.
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com
